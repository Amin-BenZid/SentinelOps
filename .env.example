# Copy to .env and adjust. Every variable is optional.

# ── Dashboard access ──
# Initial admin account (only used when the database has no users yet).
# If ADMIN_PASSWORD is empty, a random password is generated and printed ONCE in:
#   docker compose logs dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 127.0.0.1 = only this machine. Use 0.0.0.0 to expose on your network.
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=4000
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120

# Time zone used for quiet hours and logs (e.g. Africa/Lagos)
TZ=UTC

# ── Notifications (can also be set from the UI; UI values win) ──
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# ── Agent ──
HOST_ID=local-host
# true = overwrite DB rules with agent/config/rules.yaml on start (GitOps mode)
RULES_RESEED=false
ANOMALY_ENABLED=true
RAW_RETENTION_HOURS=24
ROLLUP_RETENTION_DAYS=7
ALERT_RETENTION_DAYS=30

# Optional Prometheus exporters to scrape: name=url,name2=url2
# and the metric names to keep from them
PROMETHEUS_TARGETS=
PROMETHEUS_METRICS=
