  NOTIFICATIONS_OUTBOX {
    int id PK
    int alert_id FK
    text event "firing | resolved"
    text status
    int attempts
    int next_attempt_at
    text last_error
  }
  METRICS {
    int id PK
    int ts
    text entity_id
    text metric_name
    real metric_value
    int is_anomaly
    real lower_bound
    real upper_bound
  }
  METRICS_1M {
    text entity_id PK
    text metric_name PK
    int bucket_ts PK
    real avg_value
    real min_value
    real max_value
  }
  RULES {
    text id PK
    text metric_name
    text operator
    real threshold
    int duration_seconds
    text severity
    int is_active
  }
  USERS {
    int id PK
    text username
    text password_hash
    text salt
    int must_change_password
  }
  SESSIONS {
    text token_hash PK
    int user_id FK
    int expires_at
    int last_seen_at
  }
  SETTINGS {
    text key PK
